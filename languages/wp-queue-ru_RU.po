msgid "The storage driver is not available: %s"
msgstr "Драйвер хранения недоступен: %s"

#: src/Support/DriverSwitcher.php:65
msgid "A worker is processing jobs right now. Try again in a minute."
msgstr "Сейчас воркер обрабатывает задачи. Повторите через минуту."

#. translators: 1: driver, 2: number of jobs
#: src/Support/DriverSwitcher.php:102
#, php-format
msgid "Storage driver switched to %1$s. Jobs moved: %2$d."
msgstr "Драйвер хранения переключён на %1$s. Перенесено задач: %2$d."

#. translators: 1: number, 2: queue
#: src/Support/DriverSwitcher.php:154
#, php-format
msgid "%1$d job(s) in queue \"%2$s\" are being executed. Try again when they finish."
msgstr "В очереди «%2$s» выполняется задач: %1$d. Повторите, когда они завершатся."

#: src/Support/DriverSwitcher.php:166
msgid "The current storage driver cannot move its jobs. Wait until its queues are empty, then switch."
msgstr "Текущий драйвер хранения не умеет переносить задачи. Дождитесь, пока очереди опустеют, затем переключайте."

